				<useCase>Scene-Based Lighting</useCase>
			</useCases>

        </behavioralMetadata>

        <performanceMetadata>

            <performanceCharacteristics>

                <customMetric name="brightnessLevels">
                    OFF, LOW, MID, HIGH, FULL_ON
                </customMetric>

                <customMetric name="dimmingTableEntries">
                    401 entries
                </customMetric>

                <customMetric name="transitionResolution">
                    100 dimming steps between adjacent brightness levels
                </customMetric>

                <customMetric name="cpuUtilizationModel">
                    Hardware accelerated through GPT, DMAC and ELC
                </customMetric>

            </performanceCharacteristics>

            <resources>
                <resource>1 GPT periodic timer per control instance</resource>
                <resource>1 GPT PWM timer per LED bulb</resource>
                <resource>2 DMAC channels per LED bulb</resource>
				<resource>2 PWM Outputs per LED Bulb</resource>
            </resources>

